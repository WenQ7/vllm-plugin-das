@@ -0,0 +1,129 @@
+"""Collect aligned EP8 routing work and construct a capacity-constrained expert order."""
+
+import json
+import os
+from pathlib import Path
+
+LAYERS = 88
+RANKS = 8
+PER_RANK = 44
+SAMPLES = 16
+_layers = {}
+_samples = {}
+_written = False
+
+
+def capture(prepare, ubatch, counts):
+    """Diagnostic only, after an EP8 scatter has returned its host counters."""
+    global _written
+    if _written:
+        return
+    output = os.environ.get('HCU_STEP5_EP8_CALIBRATION_DIR')
+    if not output:
+        return
+    assert prepare.num_dispatchers_ == RANKS and len(counts) == PER_RANK
+    assert prepare.rank_expert_offset % PER_RANK == 0 and ubatch in (0, 1)
+    rank = prepare.rank_expert_offset // PER_RANK
+    assert 0 <= rank < RANKS
+    index = _layers.setdefault(id(prepare), len(_layers))
+    if index >= LAYERS:
+        return
+    series = _samples.setdefault((index, ubatch), [])
+    if len(series) < SAMPLES:
+        series.append(tuple(counts))
+    if len(_samples) != 2 * LAYERS or any(len(v) != SAMPLES for v in _samples.values()):
+        return
+    doc = {'rank':rank,'samples_per_layer_and_ubatch':SAMPLES,'aligned_rows':[
+        [_samples[(layer,0)],_samples[(layer,1)]] for layer in range(LAYERS)]}
+    (Path(output)/f'rank-{rank}.json').write_text(json.dumps(doc,separators=(',',':')))
+    _written=True
+
+
+def assign_layer(rows):
+    import numpy as np
+
+    normalized = rows / np.maximum(rows.mean(axis=1,keepdims=True),1)
+    heavy = normalized.max(axis=0)
+    mean = normalized.mean(axis=0)
+    order = sorted(range(RANKS*PER_RANK),key=lambda i:(heavy[i],mean[i],-i),reverse=True)
+    bins = [[] for _ in range(RANKS)]
+    totals = np.zeros((len(rows),RANKS))
+    for expert in order:
+        dst = min((i for i in range(RANKS) if len(bins[i])<PER_RANK),
+                  key=lambda i:(float(np.max(totals[:,i]+normalized[:,expert])),
+                                float(np.mean(totals[:,i]+normalized[:,expert])),len(bins[i]),i))
+        bins[dst].append(expert)
+        totals[:,dst]+=normalized[:,expert]
+
+    def cost(t):
+        peak=t.max(axis=1)
+        return float(peak.mean()+.2*np.max(peak))
+
+    for _ in range(8):
+        best=cost(totals)
+        worst_sample,src=np.unravel_index(np.argmax(totals),totals.shape)
+        targets=np.argsort(totals[worst_sample])[:3]
+        largest=sorted(bins[src],key=lambda i:normalized[worst_sample,i],reverse=True)[:8]
+        pair=None
+        for dst in targets:
+            if dst==src:
+                continue
+            smallest=sorted(bins[dst],key=lambda i:normalized[worst_sample,i])[:8]
+            for a in largest:
+                for b in smallest:
+                    trial=totals.copy()
+                    delta=normalized[:,a]-normalized[:,b]
+                    trial[:,src]-=delta
+                    trial[:,dst]+=delta
+                    score=cost(trial)
+                    if score < best-1e-10:
+                        best=score
+                        pair=(dst,a,b,trial)
+        if pair is None:
+            break
+        dst,a,b,totals=pair
+        bins[src][bins[src].index(a)]=b
+        bins[dst][bins[dst].index(b)]=a
+    return [e for group in bins for e in group]
+
+
+def build(directory, previous_map, output):
+    import numpy as np
+    import torch
+
+    directory=Path(directory)
+    data=[]
+    for rank in range(RANKS):
+        obj=json.loads((directory/f'rank-{rank}.json').read_text())
+        assert obj['rank']==rank and obj['samples_per_layer_and_ubatch']==SAMPLES
+        arr=np.asarray(obj['aligned_rows'],dtype=np.int64)
+        assert arr.shape==(LAYERS,2,SAMPLES,PER_RANK)
+        assert np.all(arr>=0) and np.all(arr%256==0)
+        data.append(arr)
+    rows=np.concatenate(data,axis=-1).reshape(LAYERS,2*SAMPLES,RANKS*PER_RANK)
+    original=torch.load(previous_map,map_location='cpu',weights_only=True)['physical_to_logical_map']
+    assert original.shape==(LAYERS,RANKS*PER_RANK)
+    candidate=[]
+    old_max=[]
+    new_max=[]
+    for index,layer in enumerate(rows):
+        perm=assign_layer(layer)
+        assert sorted(perm)==list(range(RANKS*PER_RANK))
+        old_max.extend(layer.reshape(2*SAMPLES,RANKS,PER_RANK).sum(axis=2).max(axis=1).tolist())
+        new_max.extend(layer[:,perm].reshape(2*SAMPLES,RANKS,PER_RANK).sum(axis=2).max(axis=1).tolist())
+        candidate.append(original[index,torch.tensor(perm)])
+    result=torch.stack(candidate)
+    assert torch.equal(result.sort(dim=1).values,torch.arange(RANKS*PER_RANK).expand(LAYERS,-1))
+    torch.save({'physical_to_logical_map':result},output)
+    summary={'scope':'Predicted aligned work for calibration inputs, not a TPS measurement',
+             'layers':LAYERS,'samples_per_layer':2*SAMPLES,'rank_experts':PER_RANK,
+             'aligned_slowest_rank_rows_before':sum(old_max),'aligned_slowest_rank_rows_after':sum(new_max),
+             'predicted_reduction':1-sum(new_max)/sum(old_max)}
+    Path(output).with_suffix('.json').write_text(json.dumps(summary,indent=2))
+    print(json.dumps(summary),flush=True)
+
+
+if __name__=='__main__':
+    import sys
+
+    build(*sys.argv[1:])
