From f10f778498e9096febadaf75f14f7424236174ef Mon Sep 17 00:00:00 2001
From: yaoyuping <yaoyuping@hygon.cn>
Date: Wed, 14 Oct 2026 11:38:35 +0800
Subject: [PATCH 4/5] step5: static expert placement
 (VLLM_STEP5_EXPERT_PLACEMENT)

Permute each MoE layer's packed expert weights/scales and router rows by a
physical_to_logical_map as the checkpoint streams in, so EP rank r holds the
experts the map puts in slots [44r, 44r+44). Routing then yields physical ids
directly; no runtime cost. Prefill DP8/EP8 with a placement fitted on captured
routing: pure prefill 64000x32 19.8k -> 22.4k tok/s, real text 21.3k -> 22.4k.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/model_executor/models/step5_text.py b/model_executor/models/step5_text.py
index b5ecb1a..eafecd6 100644
--- a/model_executor/models/step5_text.py
+++ b/model_executor/models/step5_text.py
@@ -137,6 +137,17 @@ _DSA_INDEXER_SUBSTRINGS = (
 # Escape hatch back to the pre-DSA dense path, for A/B against this backend.
 DISABLE_DSA = os.environ.get("VLLM_STEP5_DISABLE_DSA", "0") == "1"
 
+# Static expert placement: a torch file holding physical_to_logical_map
+# [n_moe_layers, n_experts]. Every per-expert checkpoint tensor and the router
+# rows are permuted as they stream in, so physical slot p (EP rank p // 44)
+# holds checkpoint expert map[i, p] and routing yields physical ids directly.
+# Used to balance valid decode M-blocks across EP ranks.
+EXPERT_PLACEMENT = os.environ.get("VLLM_STEP5_EXPERT_PLACEMENT", "")
+_PLACED_TENSOR = re.compile(
+    r"layers\.(\d+)\.moe\.(?:(?:gate|up|down)_proj\.weight(?:_scale(?:_inv)?)?"
+    r"|gate\.weight|router_bias)$"
+)
+
 # Run qkv_proj and g_proj as one GEMM. Both weights become column views of one
 # [hidden, qkv + heads] buffer, so the loaders fill it in place and no
 # post-load step is needed (AutoWeightsLoader may call load_weights twice).
@@ -190,6 +201,30 @@ def _unignore_bf16_experts(quant_config: QuantizationConfig | None) -> None:
     quant_config.ignore = kept
 
 
+def _place_experts(
+    weights: Iterable[tuple[str, torch.Tensor]], moe_layer_ids: list[int]
+) -> Iterable[tuple[str, torch.Tensor]]:
+    """EXPERT_PLACEMENT: index dim 0 of each packed expert tensor and of the
+    router weight/bias with the layer's physical-to-logical map. Done on the
+    stream rather than on the loaded parameters because load_weights may run
+    more than once over parts of the checkpoint."""
+    physical_to_logical = torch.load(EXPERT_PLACEMENT)["physical_to_logical_map"]
+    assert physical_to_logical.shape[0] == len(moe_layer_ids)
+    identity = torch.arange(physical_to_logical.shape[1])
+    for row in physical_to_logical:
+        assert torch.equal(row.sort().values, identity), "not a permutation"
+    rows = dict(zip(moe_layer_ids, physical_to_logical))
+    logger.info_once("step5: expert placement loaded from %s", EXPERT_PLACEMENT)
+    for name, w in weights:
+        assert ".moe.experts." not in name, "placement needs packed experts"
+        m = _PLACED_TENSOR.search(name)
+        if m is not None and int(m.group(1)) in rows:
+            row = rows[int(m.group(1))]
+            assert w.shape[0] == row.numel(), (name, w.shape)
+            w = w[row.to(w.device)]
+        yield name, w
+
+
 def _quantize_bf16_experts(
     weights: Iterable[tuple[str, torch.Tensor]],
 ) -> Iterable[tuple[str, torch.Tensor]]:
@@ -1391,6 +1426,12 @@ class Step5Model(nn.Module):
         )
 
         disable_moe_stacked_params = [data[1] for data in expert_params_mapping]
+        if EXPERT_PLACEMENT:
+            assert get_pp_group().world_size == 1, "expert placement assumes PP=1"
+            weights = _place_experts(
+                weights,
+                [i for i, layer in enumerate(self.layers) if layer.use_moe],
+            )
         if FP8_BF16_MOE:
             weights = _quantize_bf16_experts(weights)
 
