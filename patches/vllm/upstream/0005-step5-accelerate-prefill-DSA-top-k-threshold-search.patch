From 12907f8d1c86922c8c317c8c351f7f9b77bae646 Mon Sep 17 00:00:00 2001
From: yaoyuping <yaoyuping@hygon.cn>
Date: Thu, 15 Oct 2026 19:55:32 +0800
Subject: [PATCH 5/5] step5: accelerate prefill DSA top-k threshold search

Use interpolated threshold probes for the register-resident prefill selector,
falling back to bisection when the bracket does not shrink sufficiently. The
production topk=512 selector remains bit-identical in parity tests and saves
about 0.31 ms at 16384 rows x 8192 regions.

Co-Authored-By: Claude <noreply@anthropic.com>

diff --git a/model_executor/layers/step4_dsa_kernels.py b/model_executor/layers/step4_dsa_kernels.py
index bd417ae..8270387 100644
--- a/model_executor/layers/step4_dsa_kernels.py
+++ b/model_executor/layers/step4_dsa_kernels.py
@@ -1270,9 +1270,24 @@ def _region_topk_pack_resident_kernel(
         keys = tl.where(live, keys, -2147483648)
         lo = tl.min(tl.where(live, keys, 2147483647)).to(tl.int64)
         hi = tl.max(keys).to(tl.int64) + 1
+        # Interpolate the threshold from the two bracket counts. The score key
+        # distribution is continuous for indexer logits, so this usually skips
+        # several of the ~32 fixed-width bisection passes. Keep bisection as a
+        # fallback when interpolation stops shrinking the bracket.
+        c_lo = visible.to(tl.float32)
+        c_hi = 0.0
+        target = budget.to(tl.float32) + 0.5
+        bisect = budget * 0
         done = budget * 0
         while (hi - lo > 1) & (done == 0):
-            mid = lo + (hi - lo) // 2
+            span = hi - lo
+            if bisect != 0:
+                mid = lo + span // 2
+            else:
+                frac = (c_lo - target) / (c_lo - c_hi)
+                off = (span.to(tl.float32) * frac).to(tl.int64)
+                off = tl.minimum(tl.maximum(off, 1), span - 1)
+                mid = lo + off
             above = keys >= mid.to(tl.int32)
             count = tl.sum(above.to(tl.int32))
             if count == budget:
@@ -1280,8 +1295,11 @@ def _region_topk_pack_resident_kernel(
                 done = 1
             elif count > budget:
                 lo = mid
+                c_lo = count.to(tl.float32)
             else:
                 hi = mid
+                c_hi = count.to(tl.float32)
+            bisect = ((hi - lo) * 2 > span).to(tl.int32)
         threshold = lo.to(tl.int32)
         greater = live & (keys > threshold)
         tied = live & (keys == threshold)
